# Copy to .env and fill in. setup.sh will auto-populate the GCP fields.

# GCP project and region (set by setup.sh)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Use Vertex AI as the backend (vs. direct Gemini API)
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Google Maps Platform API key (Maps Grounding Lite 有効化済み)
# ワークショップ当日に共有される (X-Goog-Api-Key ヘッダで mapstools.googleapis.com/mcp に送信)
# Section 2-2b (MCP) と 2-1 (multi-agent) の RecommendAgent で使用
MAPS_API_KEY=YOUR_MAPS_API_KEY_HERE
